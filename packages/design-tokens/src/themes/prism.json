      "c2": {
        "$value": "#d66bd1"
      },
      "c3": {
        "$value": "#2bd4a0"
      },
      "c4": {
        "$value": "#ff6b92"
      },
      "c5": {
        "$value": "#ff9a4d"
      },
      "c6": {
        "$value": "#3fd3d6"
