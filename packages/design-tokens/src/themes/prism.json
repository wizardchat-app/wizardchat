      "glow2": {
        "$value": "#004dff0d"
      }
    },
    "border": {
      "default": {
        "$value": "#26232f"
      },
      "strong": {
        "$value": "#403b4c"
      },
      "focus": {
        "$value": "#b39afa"
      }
    },
    "status": {
      "danger": {
        "$value": "#c93b3b"
      },
      "error": {
        "$value": "#ff6b6b"
      },
      "success": {
        "$value": "#3ba55d"
