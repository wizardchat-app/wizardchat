{
  "$description": "Prism (all six colours of the spectrum)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "prism",
      "name": "Prism",
      "scheme": "dark"
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#0e0d12",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#15141b",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#1e1c26",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#121117"
      },
      "hover": {
        "$value": "#ffffff0b"
      },
      "active": {
        "$value": "#8b5cf633"
      },
      "overlay": {
        "$value": "#000000a6",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#e3e3e8"
      },
      "secondary": {
        "$value": "#b7b7c0"
      },
      "muted": {
        "$value": "#8b8b98"
      },
      "disabled": {
        "$value": "#686875"
      },
      "onAccent": {
        "$value": "#ffffff"
      },
      "link": {
        "$value": "#4ea8ff"
      }
