{
  "$description": "Opaline (pastel blue, pink and white)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "opaline",
      "name": "Opaline",
      "scheme": "light"
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#ffffff",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#eef8fe",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#fdeaef",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#ffffff"
      },
      "hover": {
        "$value": "#1f8ac012"
      },
      "active": {
        "$value": "#1f8ac024"
      },
      "overlay": {
        "$value": "#1d273366",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#1d2733"
      },
      "secondary": {
        "$value": "#46566a"
      },
      "muted": {
        "$value": "#6e7f93"
